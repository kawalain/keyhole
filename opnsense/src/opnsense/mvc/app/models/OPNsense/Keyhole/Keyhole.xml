<model>
    <mount>//OPNsense/Keyhole</mount>
    <version>0.1.0</version>
    <description>keyhole censorship bypass</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <interface type="InterfaceField">
                <Default>lan</Default>
                <Required>Y</Required>
            </interface>
            <upstream type="TextField">
                <Required>Y</Required>
                <Mask>/^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(:[0-9]{1,5})?$/</Mask>
                <ValidationMessage>Enter an IPv4 address, optionally followed by :port.</ValidationMessage>
            </upstream>
        </general>
    </items>
</model>
